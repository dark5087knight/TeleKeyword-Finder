# =======================================
#  TELEGRAM BOT CONFIGURATION (EXAMPLE)
# =======================================

# Telegram API Credentials
telegram:
  api_id: 12345678
  api_hash: "your_api_hash_here"
  phone: "+1234567890"

# Bot Settings
bot:
  # Users list file - one username per line (users to send filtered messages to)
  send_to_users_file: "teljobs.d/send_to_users.conf"

  # Auto-read messages after processing
  auto_read: true

# File Paths
paths:
  # Channels list file
  channels_file: "teljobs.d/channels.conf"

  # Keywords file
  keywords_file: "teljobs.d/keywords.conf"

  # Session file for Telegram authentication
  session_file: "session_file"

  # Logs directory
  logs_dir: "logs"

  # Log file name
  log_file: "telegram_bot.log"

# Logging Configuration
logging:
  # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: "DEBUG"

  # Console log level (what to display in terminal)
  console_level: "INFO"

  # Maximum log file size in bytes (5MB)
  max_log_size: 5242880

  # Number of backup log files to keep
  backup_count: 5

# Retry Configuration
retry:
  # Wait time between connection attempts (seconds)
  retry_wait_seconds: 60

  # Maximum number of retries before giving up (-1 for infinite)
  max_retries: -1

# Keyboard Settings
keyboard:
  # Exit key: 'esc' or 'enter'
  exit_key: "esc"

  # Enable keyboard listener
  enabled: true
