# Telegram App Credentials for channel reading (from my.telegram.org)
TG_API_ID=
TG_API_HASH=

# LLM Provider Selection: openai, groq, gemini, anthropic, or ollama
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_CONTROL_MODEL=gpt-4o-mini
LLM_CLASSIFIER_MODEL=gpt-4o-mini

# Optional Telegram Bot API Token (if using Bot for forwarding alerts)
BOT_TOKEN=

# Fernet Master Encryption Key for user secrets (generate with scripts/gen_master_key.py)
SECRETS_MASTER_KEY=

# Local SQLite Database Path
DB_PATH=data/tgagent.db

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
