# ==============================================================================
# Telegram API Credentials Template
# Copy this file to .env and fill in your actual credentials.
# Get your API ID and API Hash from: https://my.telegram.org (API development tools)
# ==============================================================================

# Your integer Telegram API ID (e.g. 12345678)
TELEGRAM_API_ID=

# Your 32-character Telegram API Hash string (e.g. 0123456789abcdef0123456789abcdef)
TELEGRAM_API_HASH=

# Your international phone number with country code (e.g. +1234567890)
TELEGRAM_PHONE=
